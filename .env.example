# ============================================================
# SADI - Sistema de Auditorías y Diagnóstico ISO 27001
# Archivo de variables de entorno (copia como .env y ajusta)
# ============================================================

# --- Base de Datos (PostgreSQL) ---
POSTGRES_USER=sadi_user
POSTGRES_PASSWORD=cambia_esta_password_segura
POSTGRES_DB=sadi_db

# --- Aplicación Flask ---
SECRET_KEY=cambia_este_secreto_muy_largo_y_aleatorio_aqui
ADMIN_USERNAME=admin_sadi
ADMIN_PASSWORD=cambia_esta_password_admin

# --- MinIO / Almacenamiento de Objetos S3 ---
MINIO_ROOT_USER=sadi_minio_admin
MINIO_ROOT_PASSWORD=cambia_esta_password_minio

# Buckets (estos se crean automáticamente al iniciar la app)
# S3_BUCKET=sadi-evidencias
# S3_BUCKET_DOCS=sadi-documentacion
